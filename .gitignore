# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
# The full dataset is not published: the source footage is real match video of
# identifiable players, and the derived CSVs are shared on request. Only the
# 20-clip sample under data/sample/ is version-controlled.
clips_master.csv
biomechanics_dataset_complete.csv
proximal_distal_sequence.csv
summary_stats.csv
dataset_manual.csv

# Video and model weights
clips_raw/
clips_cropped/
01_extraction/Videos/
*.mp4
*.avi
*.mov
*.mkv
*.mts
*.m4v
*.pt
*.task

# ---------------------------------------------------------------------------
# Script outputs
# ---------------------------------------------------------------------------
# Every script in 03_statistical_analysis/ and 04_models/ writes its CSV, TXT
# and PNG results into the working directory it is run from. Those are
# regenerated by re-running the pipeline and do not belong in the repository.
Output/
output/
03_statistical_analysis/*.csv
03_statistical_analysis/*.png
03_statistical_analysis/*.txt
03_statistical_analysis/*.log
04_models/*.csv
04_models/*.png
04_models/*.txt
04_models/*.log

# ---------------------------------------------------------------------------
# Tracked exceptions
# ---------------------------------------------------------------------------
# The curated sample, the five published figures and the write-ups are part of
# the repository and override the rules above.
!data/sample/
!data/sample/*.csv
!outputs/
!outputs/plots/*.png
!outputs/reports/*.md
!docs/*.md
!*.md
!LICENSE
!requirements.txt

